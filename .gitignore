# Local lab evidence can contain private addresses, hostnames, disk models, and command output.
evidence/*
!evidence/.gitkeep

# Secrets and generated credentials
*.pem
*.key
*.crt
clouds.yaml
# Terraform state, provider downloads, plans, and variable files may contain secrets
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
*.tfvars
*.tfvars.json
*.retry
